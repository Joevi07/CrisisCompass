# ==============================================================================
# TravelTech: CrisisCompass Configuration (.env.example)
# Copy this file to .env to customize settings.
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Mode: 'demo' (uses realistic synthetic simulation where APIs lack feeds) or 'live'
APP_MODE=demo

# Database
DATABASE_URL=sqlite:///./crisis_compass.db

# Weather Provider (Default uses free Open-Meteo, no API key required)
WEATHER_PROVIDER=open-meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Official Warning Feeds (Comma-separated trusted source URLs or endpoints)
OFFICIAL_FEED_URLS=https://api.weather.gov/alerts/active,https://meteoalarm.org/feed

# AI Assistant Provider ('rule_based', 'openai', 'gemini', 'anthropic')
# Leave LLM_API_KEY blank to safely run rule-based emergency assistant
LLM_PROVIDER=rule_based
LLM_API_KEY=
LLM_MODEL=

# Translation Service Provider ('built_in', 'libretranslate', 'llm')
TRANSLATION_PROVIDER=built_in
TRANSLATION_API_KEY=

# Trusted Source Registry (Comma-separated allowed domains for official verification)
TRUSTED_SOURCE_DOMAINS=weather.gov,meteoalarm.org,imd.gov.in,bmdi.gov,nhc.noaa.gov,redcross.org,who.int,gdacs.org

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
